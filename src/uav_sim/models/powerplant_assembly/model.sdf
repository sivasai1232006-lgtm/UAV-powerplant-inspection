<?xml version="1.0"?>
<sdf version="1.11">
  <model name="powerplant_assembly">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>

    <link name="assembly_link">
      <visual name="assembly_visual">
        <geometry>
          <mesh>
            <uri>meshes/powerplant.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
      
      <collision name="assembly_collision">
        <geometry>
          <mesh>
            <uri>meshes/powerplant.stl</uri>
            <!-- The exported DAE visual is 0.16 m taller than the STL. -->
            <scale>1 1 1.01</scale>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
